class tablero:
    def __init__(self):
        self.inicio = [[""for _ in range(8)] for _ in range(8)]
        self.acomodar_fichas()

    def acomodar_fichas(self):
        for i in range(8):
            for j in range(8):
                if (i + j) % 2 != 0:
                    if i < 3:
                        self.inicio[i][j] = ficha("o")
                    elif i > 4:
                        self.inicio[i][j] = ficha("x")
    def mostrar_tablero(self):
        for fila in self.inicio:
            for celda in fila:
                if celda == "":
                    print(" . ", end="")
                else:
                    print(f" {celda.jugador} ", end="")
            print()
class ficha:
    def __init__(self, jugador):
        self.jugador = jugador
        self.reina = False

    def coronar(self):
        self.reina = True
        print(f"La ficha {self.jugador} ha sido coronada y ahora es una reina.")


mi_juego = tablero()
mi_juego.mostrar_tablero()

